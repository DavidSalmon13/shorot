OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Where room state (rooms.json) is persisted. On Railway, point this at a
# mounted Volume's path so it survives redeploys (e.g. /data).
DATA_DIR=

# Password for the owner-only stats page at /stats (daily visitors, players, games).
# Leave empty to disable the owner login for /stats and /admin.
STATS_PASSWORD=

# Postgres for accounts + lifetime game history (server/db.js). On Railway, add a
# Postgres service and reference its DATABASE_URL here. Leave empty to run without
# accounts - every game still works, results just aren't recorded.
DATABASE_URL=

# OAuth "Web application" client ID from Google Cloud Console (APIs & Services ->
# Credentials). Add your site's origin (and http://localhost:3000 for dev) under
# "Authorized JavaScript origins". Leave empty to hide Google sign-in.
GOOGLE_CLIENT_ID=

# Comma-separated Google account email(s) allowed into the admin page at /admin.
# Sign in with that Google account on the site first. Leave empty = nobody is admin.
ADMIN_EMAILS=

# Dev/testing only: make every Warfront match this many ms long (e.g. 60000), so a full
# match reaches the game-over screen quickly. Leave empty in production.
WF_DEV_MATCH_MS=

# Realistic bodies for the Spanking gag (server/bodies.js): generated once per player
# sticker with the OpenAI image API (uses OPENAI_API_KEY) and cached in DATA_DIR/bodies.
# OPENAI_IMAGE_MODEL=gpt-image-1
# BODIES_QUALITY=medium   # low | medium | high (cost per pose image goes up with quality)

# Realistic AI videos for the Go Do the Dishes, Spanking and Tomato Throw gags (server/dishVideos.js,
# server/spankVideos.js, server/tomatoVideos.js): an image-to-video model on fal.ai films each
# player's sticker washing dishes / getting spanked / getting splatted, once per sticker per gag,
# cached in DATA_DIR/dishvideos, DATA_DIR/spankvideos and DATA_DIR/tomatovideos. Get a key at fal.ai (Dashboard -> API Keys) and add credit; leave empty
# to keep the drawn animations only. Roughly $0.25-0.50 per player per gag, paid once.
FAL_KEY=
# FAL_VIDEO_MODEL=wan/v2.6/image-to-video   # any fal image-to-video endpoint taking prompt + image_url
# FAL_FRAME_MODEL=fal-ai/bytedance/seedream/v4/edit   # image-edit model for the (opt-in) spank video's first frame

# Recap videos (docs/specs/recap-videos-specs.md): a short video of each finished game, rendered on
# this server with HyperFrames and offered to the room to watch, save and share. Needs Node >= 22,
# FFmpeg and Chromium (deploy/recaps.Dockerfile has them). Off unless set to true; with it on but
# the tools missing, the server logs why and stays off. Videos go to DATA_DIR/recaps.
RECAPS_ENABLED=
# RECAP_QUALITY=draft      # draft | looks | delivery (slower, bigger files)
# RECAP_WORKERS=2          # Chrome processes per render (~256 MB each); 2 renders ~10 s of video in ~45-60 s
# RECAP_TIMEOUT_MS=180000  # a render is killed after this long
# RECAP_MAX_QUEUE=5        # waiting renders beyond this are dropped
# RECAP_TTL_HOURS=24       # recap files are deleted after this
# RECAP_MAX_DISK_MB=500    # oldest recaps are deleted first when over this
